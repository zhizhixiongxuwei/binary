{
  "name": "binaryscan-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:demo": "vite --host 127.0.0.1 --mode demo",
    "build": "vue-tsc -b && vite build",
    "build:demo": "vue-tsc -b && vite build --mode demo --outDir dist-demo",
    "test": "vitest run",
    "typecheck": "vue-tsc -b"
  },
  "dependencies": {
    "element-plus": "2.11.0",
    "lucide-vue-next": "0.468.0",
    "monaco-editor": "0.52.2",
    "pinia": "3.0.3",
    "vue": "3.5.20",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@vitejs/plugin-vue": "6.0.1",
    "@vue/tsconfig": "0.8.1",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "4.0.16",
    "vue-tsc": "3.0.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}

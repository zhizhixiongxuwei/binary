* text=auto
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
*.yml text eol=lf
*.env text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf

# Vendored SBOM schemas retain the bytes recorded in their SHA-256 manifest.
app/backend/internal/sbom/schemas/* -text whitespace=-blank-at-eol,-blank-at-eof

.DS_Store
.idea/
.vscode/
*.log
*.tmp
*.swp

app/backend/bin/
app/backend/coverage.out
app/frontend/node_modules/
app/frontend/dist/
checkers/**/target/
checkers/python/__pycache__/
checkers/python/.pytest_cache/

# Generated bundles, build cache, and script bytecode are not source files.
/local/
/release/
/.local-*/
/.release-*/
/.cache/
/script/**/__pycache__/
/test-fixtures/

# 根 .env 保留现有仓库配置策略；生成包内 .env 随 local/release 一起忽略。
!.env
